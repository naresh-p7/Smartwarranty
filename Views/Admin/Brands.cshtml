@model IEnumerable<SmartWarranty_2.Models.Brand>
@{
    ViewData["Title"] = "Brands";
}
<h2>Brand Management</h2>
<form asp-action="CreateBrand" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <div class="row g-2">
        <div class="col-md-4"><input name="Name" class="form-control" placeholder="Brand name" required /></div>
        <div class="col-md-4"><input name="OfficialWebsiteUrl" class="form-control" placeholder="Official website" /></div>
        <div class="col-md-4"><input name="WarrantyClaimUrl" class="form-control" placeholder="Warranty claim URL" /></div>
        <div class="col-md-4"><input name="SupportPhoneNumber" class="form-control" placeholder="Support phone" /></div>
        <div class="col-md-4"><input name="SupportEmailAddress" class="form-control" placeholder="Support email" /></div>
        <div class="col-md-12"><input name="Description" class="form-control" placeholder="Description" /></div>
    </div>
    <button class="btn btn-primary mt-2" type="submit">Add Brand</button>
</form>
<table class="table table-striped"><thead><tr><th>Name</th><th>Website</th><th>Support Phone</th><th>Email</th></tr></thead><tbody>@foreach(var b in Model){<tr><td>@b.Name</td><td>@b.OfficialWebsiteUrl</td><td>@b.SupportPhoneNumber</td><td>@b.SupportEmailAddress</td></tr>}</tbody></table>

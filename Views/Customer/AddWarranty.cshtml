@model SmartWarranty_2.ViewModels.WarrantyRegistrationViewModel
@{
    ViewData["Title"] = "Add Warranty";
    var products = ViewBag.Products as IEnumerable<SmartWarranty_2.Models.Product> ?? Enumerable.Empty<SmartWarranty_2.Models.Product>();
}
<h2>Add Warranty</h2>
<form asp-action="AddWarranty" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="ProductId" class="form-label"></label><select asp-for="ProductId" class="form-select">@foreach(var p in products){<option value="@p.Id">@p.Name</option>}</select><span asp-validation-for="ProductId" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" type="date" class="form-control" /><span asp-validation-for="StartDate" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="DurationMonths" class="form-label"></label><input asp-for="DurationMonths" class="form-control" /><span asp-validation-for="DurationMonths" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="ExpiryDate" class="form-label"></label><input asp-for="ExpiryDate" type="date" class="form-control" /><span asp-validation-for="ExpiryDate" class="text-danger"></span></div>
        <div class="col-md-12"><label asp-for="WarrantyType" class="form-label"></label><input asp-for="WarrantyType" class="form-control" /><span asp-validation-for="WarrantyType" class="text-danger"></span></div>
    </div>
    <button class="btn btn-primary mt-3" type="submit">Save Warranty</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

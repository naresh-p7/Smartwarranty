@model SmartWarranty_2.ViewModels.InvoiceReviewViewModel
@{
    ViewData["Title"] = "Review Invoice Details";
}
<h2>Review Invoice Details</h2>
@if (!Model.ExtractedTextFound)
{
    <div class="alert alert-warning">No readable invoice text was detected. Enter or correct the product details below before saving.</div>
}
else
{
    <div class="alert alert-info">Check the locally recognized details and correct any mistakes. A warranty is added only if you enter its duration.</div>
}
<form asp-action="ReviewInvoice" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="ProductId" type="hidden" />
    <input asp-for="ExtractedTextFound" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="ProductName" class="form-label"></label><input asp-for="ProductName" class="form-control" /><span asp-validation-for="ProductName" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="ModelNumber" class="form-label"></label><input asp-for="ModelNumber" class="form-control" /><span asp-validation-for="ModelNumber" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="SerialNumber" class="form-label"></label><input asp-for="SerialNumber" class="form-control" /><span asp-validation-for="SerialNumber" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="PurchaseDate" class="form-label"></label><input asp-for="PurchaseDate" type="date" class="form-control" /><span asp-validation-for="PurchaseDate" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="SellerName" class="form-label"></label><input asp-for="SellerName" class="form-control" /><span asp-validation-for="SellerName" class="text-danger"></span></div>
    </div>
    <hr />
    <h4>Warranty application details</h4>
    <p class="text-muted">Confirm the duration shown on your warranty terms. Any value recognized from the invoice is only a suggestion; the expiry date will be calculated automatically.</p>
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="WarrantyStartDate" class="form-label"></label><input asp-for="WarrantyStartDate" type="date" class="form-control" /><span asp-validation-for="WarrantyStartDate" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="WarrantyDurationMonths" class="form-label"></label><input asp-for="WarrantyDurationMonths" class="form-control" /><span asp-validation-for="WarrantyDurationMonths" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="WarrantyType" class="form-label"></label><input asp-for="WarrantyType" class="form-control" /><span asp-validation-for="WarrantyType" class="text-danger"></span></div>
    </div>
    <button class="btn btn-primary mt-3" type="submit">Save Product Details</button>
    <a class="btn btn-outline-secondary mt-3" asp-action="Products">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

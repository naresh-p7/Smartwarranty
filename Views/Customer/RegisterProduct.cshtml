@model SmartWarranty_2.ViewModels.ProductRegistrationViewModel
@{
    ViewData["Title"] = "Register Product";
    var brands = ViewBag.Brands as IEnumerable<SmartWarranty_2.Models.Brand> ?? Enumerable.Empty<SmartWarranty_2.Models.Brand>();
    var categories = ViewBag.Categories as IEnumerable<SmartWarranty_2.Models.ProductCategory> ?? Enumerable.Empty<SmartWarranty_2.Models.ProductCategory>();
}
<h2>Register Product</h2>
<form asp-action="RegisterProduct" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="BrandId" class="form-label">Existing Brand</label>
            <select asp-for="BrandId" class="form-select">
                <option value="">Select Brand</option>
                @foreach (var brand in brands)
                {
                    <option value="@brand.Id">@brand.Name</option>
                }
            </select>
            <span asp-validation-for="BrandId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="BrandName" class="form-label"></label>
            <input asp-for="BrandName" class="form-control" />
            <div class="form-text">If the brand is not listed, enter it here. It will be added to the brand list.</div>
            <span asp-validation-for="BrandName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" class="form-select">
                <option value="">Select Category</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ModelNumber" class="form-label"></label>
            <input asp-for="ModelNumber" class="form-control" />
            <span asp-validation-for="ModelNumber" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="SerialNumber" class="form-label"></label>
            <input asp-for="SerialNumber" class="form-control" />
            <span asp-validation-for="SerialNumber" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="PurchaseDate" class="form-label"></label>
            <input asp-for="PurchaseDate" type="date" class="form-control" />
            <span asp-validation-for="PurchaseDate" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="SellerName" class="form-label"></label>
            <input asp-for="SellerName" class="form-control" />
            <span asp-validation-for="SellerName" class="text-danger"></span>
        </div>
    </div>
    <button class="btn btn-primary mt-3" type="submit">Register</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

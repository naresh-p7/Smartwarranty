@model IEnumerable<SmartWarranty_2.Models.Brand>
@{
    ViewData["Title"] = "Manufacturer Support";
}
<h2>Manufacturer Support</h2>
<table class="table table-striped"><thead><tr><th>Brand</th><th>Website</th><th>Claim URL</th><th>Support Phone</th><th>Support Email</th></tr></thead><tbody>@foreach(var brand in Model){<tr><td>@brand.Name</td><td><a href="@brand.OfficialWebsiteUrl" target="_blank">Website</a></td><td><a href="@brand.WarrantyClaimUrl" target="_blank">Claim</a></td><td>@brand.SupportPhoneNumber</td><td>@brand.SupportEmailAddress</td></tr>}</tbody></table>

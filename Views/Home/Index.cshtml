@{
    ViewData["Title"] = "Home";
}

<section class="hero bg-primary text-white rounded-4 p-5 mb-4">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <span class="badge bg-light text-primary mb-3">Digital Warranty Management</span>
            <h1 class="display-5 fw-bold">SmartWarranty keeps every product, warranty, and claim in one secure place.</h1>
            <p class="lead mt-3">Track product registrations, warranty expiry dates, service history, support links, and document uploads for every product you own.</p>
            <div class="d-flex gap-3 flex-wrap mt-4">
                <a asp-controller="Account" asp-action="CustomerRegister" class="btn btn-light btn-lg">Get Started</a>
                <a asp-controller="Account" asp-action="CustomerLogin" class="btn btn-outline-light btn-lg">Customer Login</a>
                <a asp-controller="Account" asp-action="CustomerRegister" class="btn btn-outline-light btn-lg">Register Now</a>
            </div>
        </div>
        <div class="col-lg-5 text-center">
            <div class="bg-white text-dark rounded-4 p-4 shadow">
                <div class="small text-uppercase text-muted mb-2">Overview</div>
                <div class="display-6 fw-bold text-primary">24/7</div>
                <div class="text-muted">Warranty visibility and service tracking</div>
            </div>
        </div>
    </div>
</section>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h5>Register Products</h5>
                <p class="text-muted">Create a centralized record for every purchased item with model, serial, seller, and purchase details.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h5>Manage Warranties</h5>
                <p class="text-muted">Track warranty start dates, expiry windows, active status, and expiring soon reminders.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h5>Track Service Requests</h5>
                <p class="text-muted">Log manufacturing support issues and maintain claim reference numbers and service updates.</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h4>Why digital warranty management matters</h4>
                <p>SmartWarranty helps customers organize product purchases, maintain proof of ownership, and monitor warranty coverage without missing renewal and claim deadlines.</p>
                <ul>
                    <li>Secure document storage</li>
                    <li>Eligibility checks for reference only</li>
                    <li>Official manufacturer support links</li>
                    <li>Service tracking history</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h4>How it works</h4>
                <ol>
                    <li>Register customer account</li>
                    <li>Add purchased products and brands</li>
                    <li>Save warranty start and expiry details</li>
                    <li>Upload invoice or certificate documents</li>
                    <li>Track support requests and manufacturer updates</li>
                </ol>
            </div>
        </div>
    </div>
</div>
